{
	"name": "yamabiko-divi-gutenberg-elements",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"format": "wp-scripts format \"**/*.{js,jsx,mjs,json,yml,yaml}\"",
		"format:check": "prettier --check \"**/*.{js,jsx,mjs,json,yml,yaml}\"",
		"lint:js": "wp-scripts lint-js . --max-warnings=0",
		"lint:css": "wp-scripts lint-style \"src/**/*.{css,scss}\" --allow-empty-input",
		"format:css": "wp-scripts lint-style \"src/**/*.{css,scss}\" --fix --allow-empty-input",
		"test": "npm run format:check && npm run lint:js && npm run lint:css",
		"audit:security": "npm audit --omit=dev --audit-level=high"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^25.8.0",
		"@wordpress/prettier-config": "^4.52.0",
		"@wordpress/scripts": "^34.0.0",
		"@wordpress/stylelint-config": "^24.1.0",
		"prettier": "npm:wp-prettier@^3.0.3"
	}
}
