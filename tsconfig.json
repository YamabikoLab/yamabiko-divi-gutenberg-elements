{
	"compilerOptions": {
		"allowJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": [ "DOM", "ES2021" ],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"paths": {
			"@/*": [ "src/*" ]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2021"
	},
	"include": [ "src/**/*.ts", "src/**/*.tsx" ]
}
